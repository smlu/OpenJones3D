// Engine functions that sithDSS.c calls and that the vector tests replace with the stubs of sithDSSVecRun.h.
//  DSSV_SEAM:   engine calls with side effects; the capture harness patches the original function to jump to the stub
//  DSSV_LOOKUP: pure index/pointer lookups on the world; the harness leaves the original running (on the synthetic
//               world) and checks the stub against it
// Each name N is replaced by dssv_N in the tested sources (see CMakeLists.txt).
DSSV_SEAM(sithMessage_SendMessage)
DSSV_SEAM(sithMessage_GetSenderID)
DSSV_SEAM(stdComm_IsGameHost)
DSSV_SEAM(stdComm_IsGameActive)
DSSV_SEAM(sithSector_HideSectorAdjoins)
DSSV_SEAM(sithSector_ShowSectorAdjoins)
DSSV_SEAM(sithVehicleControls_GetMineCarState)
DSSV_SEAM(sithVehicleControls_GetRaftState)
DSSV_SEAM(sithVehicleControls_SetMineCarState)
DSSV_SEAM(sithVehicleControls_SetRaftState)
DSSV_SEAM(sithPlayerControls_GetVehicleBoardedThing)
DSSV_SEAM(sithPlayerControls_SetVehicleBoardedThing)
DSSV_SEAM(sithPuppet_SetMoveMode)
DSSV_SEAM(sithPuppet_SetArmedMode)
DSSV_SEAM(sithPuppet_NewTrack)
DSSV_SEAM(rdPuppet_NewEntry)
DSSV_SEAM(sithEvent_CreateEvent)
DSSV_SEAM(sithAnimate_GetAnim)
DSSV_SEAM(sithAnimate_Create)
DSSV_SEAM(sithAnimate_Stop)
DSSV_SEAM(stdMemory_Malloc)
DSSV_SEAM(stdMemory_Free)
DSSV_LOOKUP(sithThing_GetThingByIndex)
DSSV_LOOKUP(sithThing_GetThingIndex)
DSSV_LOOKUP(sithSector_GetSectorEx)
DSSV_LOOKUP(sithSector_GetSectorIndex)
DSSV_LOOKUP(sithSurface_GetSurfaceEx)
DSSV_LOOKUP(sithSurface_GetSurfaceIndex)
DSSV_LOOKUP(sithModel_GetModelByIndex)
DSSV_LOOKUP(sithModel_GetModelIndex)
DSSV_LOOKUP(sithMaterial_GetMaterialByIndex)
DSSV_LOOKUP(sithCog_GetCogByIndex)
DSSV_LOOKUP(sithPuppet_GetKeyframeByIndex)
