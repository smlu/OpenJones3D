layout(std140) uniform CameraData {
    mat4 VIEW;
    mat4 INVERSE_VIEW;
    mat4 PROJECTION;
    mat4 INVERSE_PROJECTION;
    mat4 VIEWPROJECTION;
    float NEAR_PLANE;
    float FAR_PLANE;
    float FOCAL_LENGTH;
    float TIME;
};

layout(std140) uniform ViewportData {
    vec4 VIEWPORT;
};

layout(std140) uniform FogData {
    float FOG_B_ENABLED;
    float FOG_START;
    float FOG_END;
    float FOG_DEPTH;
    vec3 FOG_COLOR;
};

#define MAX_LIGHTS 64

struct PointLight
{
    vec4 position;   // xyz = position, w = unused
    vec4 color;      // rgba
    float minRadius;
    float maxRadius;
    vec2 _pad;       // padding für std140
};

layout(std140) uniform PointLightsData
{
    PointLight LIGHTS[MAX_LIGHTS];
    int LIGHT_COUNT;
};
