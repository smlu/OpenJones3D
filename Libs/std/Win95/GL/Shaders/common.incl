#include <globals.incl>
//uniform vec4 VIEWPORT;

#define VS_SCREEN   0
#define VS_WORLD    1
#define VS_VIEW     2
#define VS_CLIP     3
#define VS_MODEL    4

//light modes
#define LM_NONE    0 // full lit (white color)
#define LM_LIT     1 // only extra light
#define LM_DIFFUSE 2 // only extra light
#define LM_GOURAUD 3 // extra light + vertex lights + dynamic lights

uniform vec4 vFogParams;
uniform vec3 vFogColor;

uniform int iLightMode = 0;

vec4 screenToClip(vec3 screenPos, float rhw)
{
    float width  = VIEWPORT.z - VIEWPORT.x;
    float height = VIEWPORT.w - VIEWPORT.y;

    float w_clip = 1.0 / rhw;


    float ndc_x = ((screenPos.x - VIEWPORT.x) / width)  * 2.0 - 1.0;
    float ndc_y = (1.0 - (screenPos.y - VIEWPORT.y) / height) * 2.0 - 1.0;

    vec4 clip;
    clip.x = ndc_x * w_clip;
    clip.y = ndc_y * w_clip;
    clip.z = (screenPos.z * 2.0 - 1.0) * w_clip;
    clip.w = w_clip;

    return clip;
}

vec3 ApplyFog(vec3 color, float depth)
{

    float fogFactor = (depth - FOG_START) * FOG_DEPTH;
    fogFactor = clamp(fogFactor, 0.0f, 1.0f) * FOG_B_ENABLED;

    return mix(color, FOG_COLOR, fogFactor);
}

vec3 CalculateLightColor(vec3 worldPos)
{
    vec3 finalColor = vec3(0.0f);

    for (int i = 0; i < LIGHT_COUNT; i++)
    {
        PointLight light = LIGHTS[i];
        vec3 lightPos = light.position.xyz;
        vec3 lightDir = lightPos - worldPos;

        float dist = length(lightDir);
        //float range = step(dist, light.maxRadius);
        float fade = light.maxRadius * 0.5f;
        float innerRange = light.maxRadius * 0.75f;
        float outerRange = light.maxRadius * 1.25f;
        float range = 1.0 - smoothstep(innerRange, outerRange, dist);
        float att = dist * 0.8f;
        vec3 contrib = (light.color.rgb - vec3(att)) * range;
        contrib = max(contrib, vec3(0.0));
        finalColor += contrib;
    }

    return clamp(finalColor, vec3(0.0f), vec3(1.0f));
}

vec3 CalculateLightColorLegacy(vec3 worldPos)
{
    vec3 finalColor = vec3(0.0f);

    for (int i = 0; i < LIGHT_COUNT; i++)
    {
        PointLight light = LIGHTS[i];
        vec3 lightPos = light.position.xyz;
        vec3 lightDir = lightPos - worldPos;

        float dist = length(lightDir);
        float range = step(dist, light.maxRadius);
        float fade = light.maxRadius * 0.5f;
        //float range = 1.0 - smoothstep(fade, light.maxRadius, dist);
        float att = dist * 0.8f;
        vec3 contrib = (light.color.rgb - vec3(att)) * range;
        contrib = max(contrib, vec3(0.0));
        finalColor += contrib;
    }

    return clamp(finalColor, vec3(0.0f), vec3(1.0f));
}

vec3 CalculateModelLightColor(PointLight light, vec3 worldPos, vec3 worldNormal)
{
    vec3 lightPos = light.position.xyz;
    vec3 lightDir = lightPos - worldPos;
    float dist = length(lightDir);
    float innerRadius = light.maxRadius * 0.75f;
    float outerRadius = light.minRadius * 1.25f;

    lightDir = normalize(lightDir);
    vec3 normal = normalize(worldNormal);
    float ndotl = max(dot(normal, lightDir), 0.0f);

    // Keep legacy behavior (full light up to maxRadius, zero at minRadius),
    // but use smooth interpolation in-between to avoid a visible hard ring.
    float attenuation = 1.0f - smoothstep(innerRadius, outerRadius, dist);

    return light.color.rgb * ndotl * attenuation;
}

vec3 CalculateModelLighting(vec3 worldPos, vec3 worldNormal)
{
    vec3 finalColor = vec3(0.0f);

    for (int i = 0; i < LIGHT_COUNT; i++)
    {
        PointLight light = LIGHTS[i];
        finalColor += CalculateModelLightColor(light, worldPos, worldNormal);
    }

    return clamp(finalColor, vec3(0.0f), vec3(1.0f));
}

vec3 CalculateModelLightColorLegacy(PointLight light, vec3 worldPos, vec3 worldNormal)
{
    vec3 lightPos = light.position.xyz;
    vec3 lightDir = lightPos - worldPos;

    float dist = length(lightDir);
    float maxRange = float(dist < light.maxRadius);

    lightDir = normalize(lightDir);
    float dot = dot(worldNormal, lightDir);
    vec3 maxLight = light.color.rgb * maxRange * dot;
    maxLight = max(maxLight, vec3(0.0));

    float minRange = float(dist > light.maxRadius) * float(dist < light.minRadius);
    float dRad = light.minRadius - light.maxRadius;
    float atten = (dist - light.maxRadius) / dRad;
    vec3 minLight = (light.color.rgb - vec3(atten) * light.color.rgb) * dot * minRange;
    minLight = max(minLight, vec3(0.0f));

    return maxLight + minLight;
}

vec3 CalculateModelLightingLegacy(vec3 worldPos, vec3 worldNormal)
{
    vec3 finalColor = vec3(0.0f);

    for (int i = 0; i < LIGHT_COUNT; i++)
    {
        PointLight light = LIGHTS[i];
        finalColor += CalculateModelLightColorLegacy(light, worldPos, worldNormal);
    }

    return clamp(finalColor, vec3(0.0f), vec3(1.0f));

}


vec3 CalculateVertexColor(vec3 vertexColor, vec3 extraLight, int lightMode)
{
    if (lightMode == LM_NONE)
    {
        return vec3(1.0f);
    }

    vec3 finalColor = extraLight;

    if (lightMode == LM_GOURAUD)
    {
        finalColor += vertexColor;
    }

    return clamp(finalColor, vec3(0.0f), vec3(1.0f));
}