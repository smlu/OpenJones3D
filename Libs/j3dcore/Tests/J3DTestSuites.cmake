# jones3d_add_test_suites(<target>
#     [CHILD_HANDLER <function>]
#     [UNIT <suite>...]
#     [SYSTEM <suite>...]
#     [DISRUPTIVE <suite>...]
# )
#
# Generates the main() of a module test executable. Every suite is a Unity group runner (TEST_GROUP_RUNNER(<suite>))
# compiled into <target>; main() runs them with J3DTest_RunSuites, so --suite, --exclude-suite, --kind,
# --exclude-system and --list work in every module test executable. Suites run in the listed order.
#
# CHILD_HANDLER names a function `int <function>(int argc, const char* argv[], int* pExitCode)` that main() calls
# first. It returns nonzero when argv selects a child process mode of the tests, and sets *pExitCode.
function(jones3d_add_test_suites TARGET)
    cmake_parse_arguments(ARG "" "CHILD_HANDLER" "UNIT;SYSTEM;DISRUPTIVE" ${ARGN})
    if (ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "jones3d_add_test_suites(${TARGET}): unknown arguments: ${ARG_UNPARSED_ARGUMENTS}")
    endif()

    set(DECLS "")
    set(ENTRIES "")
    set(NUM_SUITES 0)
    foreach(KIND UNIT SYSTEM DISRUPTIVE)
        foreach(SUITE ${ARG_${KIND}})
            string(APPEND DECLS "void TEST_${SUITE}_GROUP_RUNNER(void);\n")
            string(APPEND ENTRIES "    { \"${SUITE}\", TEST_${SUITE}_GROUP_RUNNER, J3DTEST_SUITE_${KIND} },\n")
            math(EXPR NUM_SUITES "${NUM_SUITES} + 1")
        endforeach()
    endforeach()

    if (NUM_SUITES EQUAL 0)
        message(FATAL_ERROR "jones3d_add_test_suites(${TARGET}): no suites")
    endif()

    set(CHILD_DECL "")
    set(CHILD_CALL "")
    if (ARG_CHILD_HANDLER)
        set(CHILD_DECL "int ${ARG_CHILD_HANDLER}(int argc, const char* argv[], int* pExitCode);\n")
        set(CHILD_CALL "    int exitCode = 0;\n    if ( ${ARG_CHILD_HANDLER}(argc, argv, &exitCode) )\n    {\n        return exitCode;\n    }\n\n")
    endif()

    set(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}Suites.c")
    file(GENERATE OUTPUT "${OUTPUT}" CONTENT
"// Generated by jones3d_add_test_suites() for ${TARGET}. Do not edit.
#include <j3dcore/Tests/j3dTestRunner.h>

${DECLS}${CHILD_DECL}
static const J3DTestSuite ${TARGET}_aSuites[] = {
${ENTRIES}};

int main(int argc, const char* argv[])
{
${CHILD_CALL}    return J3DTest_RunSuites(argc, argv, ${TARGET}_aSuites, sizeof(${TARGET}_aSuites) / sizeof(${TARGET}_aSuites[0]));
}
")

    target_sources(${TARGET} PRIVATE "${OUTPUT}")
    source_group("Generated" FILES "${OUTPUT}")
    target_link_libraries(${TARGET} PRIVATE j3dTestSupport)
endfunction()

# jones3d_get_external_definitions(<files> <output variable>)
#
# Lists the names of the external functions and globals defined at file scope in C files: lines that start at column 0
# with a type and are not static, extern, typedef, struct, union or enum. Function prototypes (ending with ';') are
# skipped. It doesn't evaluate the preprocessor, so names defined under #if are listed too.
function(jones3d_get_external_definitions FILES OUTPUT)
    set(NAMES "")
    foreach(FILE IN LISTS FILES)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${FILE}")
        file(READ "${FILE}" TEXT)
        # Make every line a list element: protect the list separators and escapes first
        string(REPLACE "\\" "<BS>" TEXT "${TEXT}")
        string(REPLACE ";" "<SC>" TEXT "${TEXT}")
        string(REPLACE "[" "<LB>" TEXT "${TEXT}")
        string(REPLACE "]" "<RB>" TEXT "${TEXT}")
        string(REPLACE "\r" "" TEXT "${TEXT}")
        string(REPLACE "\n" ";" LINES "${TEXT}")

        foreach(LINE IN LISTS LINES)
            if (NOT LINE MATCHES "^[A-Za-z_]" OR LINE MATCHES "^(static|extern|typedef|struct|union|enum)[ \t]")
                continue()
            endif()

            # Each test is the last MATCHES of its condition, which sets CMAKE_MATCH_1
            set(bPrototype FALSE)
            if (LINE MATCHES "<SC>[ \t]*$")
                set(bPrototype TRUE)
            endif()

            if (NOT bPrototype AND LINE MATCHES "^[^(=]*[ *]([A-Za-z_][A-Za-z0-9_]*)[ \t]*\\(")
                list(APPEND NAMES "${CMAKE_MATCH_1}") # Function definition
            elseif (LINE MATCHES "^[^(=]*[ *]([A-Za-z_][A-Za-z0-9_]*)[ \t]*(<LB>[^<]*<RB>)*[ \t]*(=.*|<SC>[ \t]*)$")
                list(APPEND NAMES "${CMAKE_MATCH_1}") # Global variable definition
            endif()
        endforeach()
    endforeach()

    list(REMOVE_DUPLICATES NAMES)
    set(${OUTPUT} "${NAMES}" PARENT_SCOPE)
endfunction()

# jones3d_isolate_test_sources(<prefix>
#     SOURCES <files>
#     [SCAN <files>]
#     [NAMES <names>...]
#     [EXCLUDE <names>...]
# )
#
# Gives the test sources of one suite their own names, so suites that compile the same production sources with
# different seams, or define the same fixtures, can link into one module test executable. Every external function and
# global defined in the SCAN files (the suite's test sources, its copies of production sources and the headers that
# define functions), plus NAMES (e.g. stubs generated by macros), is renamed to <prefix>_<name> in the SOURCES
# translation units, by a generated header force-included before anything else. EXCLUDE lists names to keep, such as
# names that headers of these sources define as macros. Calls to functions the suite doesn't compile go to the
# libraries as before.
function(jones3d_isolate_test_sources PREFIX)
    cmake_parse_arguments(ARG "" "" "SOURCES;SCAN;NAMES;EXCLUDE" ${ARGN})
    if (ARG_UNPARSED_ARGUMENTS OR NOT ARG_SOURCES)
        message(FATAL_ERROR "jones3d_isolate_test_sources(${PREFIX}): needs SOURCES, unknown arguments: ${ARG_UNPARSED_ARGUMENTS}")
    endif()

    jones3d_get_external_definitions("${ARG_SCAN}" NAMES)
    list(APPEND NAMES ${ARG_NAMES})
    list(REMOVE_DUPLICATES NAMES)
    if (ARG_EXCLUDE)
        list(REMOVE_ITEM NAMES ${ARG_EXCLUDE})
    endif()

    # A name that is already a macro, a seam rename given on the command line (-D), keeps it; its target is renamed.
    # Code that pastes _ADDR to a function name (the retail address constants) gets the original constant.
    set(RENAMES "")
    foreach(NAME IN LISTS NAMES)
        string(APPEND RENAMES "#ifndef ${NAME}\n#define ${NAME} ${PREFIX}_${NAME}\n#endif\n#define ${PREFIX}_${NAME}_ADDR ${NAME}_ADDR\n")
    endforeach()

    set(HEADER "${CMAKE_CURRENT_BINARY_DIR}/${PREFIX}Renames.h")
    file(GENERATE OUTPUT "${HEADER}" CONTENT
"// Generated by jones3d_isolate_test_sources() for the ${PREFIX} test sources. Do not edit.
#ifndef ${PREFIX}_RENAMES_H
#define ${PREFIX}_RENAMES_H
${RENAMES}#endif
")

    if (MSVC)
        set(OPTION "/FI${HEADER}")
    else()
        set(OPTION -include "${HEADER}")
    endif()

    # Before the force-included headers the suite already has, so their declarations are renamed too
    foreach(SOURCE IN LISTS ARG_SOURCES)
        get_property(OPTIONS SOURCE "${SOURCE}" PROPERTY COMPILE_OPTIONS)
        set_property(SOURCE "${SOURCE}" PROPERTY COMPILE_OPTIONS ${OPTION} ${OPTIONS})
    endforeach()
endfunction()
