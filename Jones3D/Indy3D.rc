    LTEXT           "Mip Map:",-1,193,114,30,8
    GROUPBOX        "Error Output",-1,7,131,133,28
    CONTROL         "Normal",1013,"Button",BS_AUTORADIOBUTTON,13,143,38,10
    CONTROL         "Console",1014,"Button",BS_AUTORADIOBUTTON,51,143,38,10
    CONTROL         "Log File",1015,"Button",BS_AUTORADIOBUTTON,93,143,38,10
