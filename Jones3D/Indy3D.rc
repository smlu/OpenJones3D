// Dialog templates for standalone builds, from the decompilation's Jones3D/Indy3D.rc
// (https://github.com/andrewspode/infernal-machine-decomp-public). The icons are left out: their loaders cope with a missing icon.
// windres can't parse DLGINIT, so its empty combo box entries for dialogs 101, 106 and 114 are left out too.
#include <windows.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

101 DIALOG 0, 0, 425, 234
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Welcome to Indy 3D"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "&Start Game",1,149,207,50,14
    PUSHBUTTON      "&Exit",2,223,207,50,14
    GROUPBOX        "Display Settings",-1,7,7,268,99
    COMBOBOX        1030,17,19,251,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
